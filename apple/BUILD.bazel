# LarkSync Apple & Swift Build Definitions

load("@rules_swift//swift:swift.bzl", "swift_interop_hint", "swift_library", "swift_test")

package(default_visibility = ["//visibility:public"])

# 1. Mozilla UniFFI C-ABI Bridge Headers & Modulemap
cc_library(
    name = "larksync_ffiFFI",
    srcs = ["Sources/larksync_ffiFFI/larksync_ffiFFI.c"],
    hdrs = ["Sources/larksync_ffiFFI/include/larksync_ffiFFI.h"],
    aspect_hints = [":larksync_ffi_swift_interop"],
    includes = ["Sources/larksync_ffiFFI/include"],
    tags = ["swift_module=larksync_ffiFFI"],
    visibility = ["//visibility:public"],
)

swift_interop_hint(
    name = "larksync_ffi_swift_interop",
    module_map = "Sources/larksync_ffiFFI/include/module.modulemap",
    module_name = "larksync_ffiFFI",
)

# 2. TTZip 官方开源插件 SDK (轻量协议与 8 大扩展点)
swift_library(
    name = "TTZipPluginKit",
    srcs = glob(["Sources/TTZipPluginKit/*.swift"]),
    copts = [
        "-enable-upcoming-feature",
        "StrictConcurrency",
    ],
    module_name = "TTZipPluginKit",
    visibility = ["//visibility:public"],
)

# 3. LarkSyncCore (Mozilla UniFFI 生成的强类型 Swift 接口)
swift_library(
    name = "LarkSyncCore",
    srcs = ["Sources/LarkSyncCore/larksync_ffi.swift"],
    copts = [
        "-enable-upcoming-feature",
        "StrictConcurrency",
    ],
    module_name = "LarkSyncCore",
    visibility = ["//visibility:public"],
    deps = [
        ":larksync_ffiFFI",
    ],
)

# 4. 类 Typora 所见即所得 Markdown 引擎与主题渲染库
swift_library(
    name = "TTMarkdownKit",
    srcs = glob(["Sources/TTMarkdownKit/*.swift"]),
    copts = [
        "-enable-upcoming-feature",
        "StrictConcurrency",
    ],
    data = glob(["Sources/TTMarkdownKit/Resources/**"]),
    module_name = "TTMarkdownKit",
    visibility = ["//visibility:public"],
    deps = [
        ":TTZipPluginKit",
    ],
)

# 5. LarkSync 飞书知识库原生 UI 组件 (米勒列 / 检查器 / 编辑器)
swift_library(
    name = "LarkSyncUI",
    srcs = glob(["Sources/LarkSyncUI/*.swift"]),
    copts = [
        "-enable-upcoming-feature",
        "StrictConcurrency",
    ],
    module_name = "LarkSyncUI",
    visibility = ["//visibility:public"],
    deps = [
        ":LarkSyncCore",
        ":TTMarkdownKit",
        ":TTZipPluginKit",
    ],
)

# 6. LarkSync 官方标杆插件入口
swift_library(
    name = "LarkSyncPlugin",
    srcs = glob(["Sources/LarkSyncPlugin/*.swift"]),
    copts = [
        "-enable-upcoming-feature",
        "StrictConcurrency",
    ],
    module_name = "LarkSyncPlugin",
    visibility = ["//visibility:public"],
    deps = [
        ":LarkSyncCore",
        ":LarkSyncUI",
        ":TTMarkdownKit",
        ":TTZipPluginKit",
    ],
)

# 7. 单元测试套件 (需要访问用户目录进行插件解压与安装，标记 local 避免沙盒阻止)
swift_test(
    name = "TTZipPluginKitTests",
    srcs = glob(["Tests/TTZipPluginKitTests/*.swift"]),
    copts = [
        "-enable-upcoming-feature",
        "StrictConcurrency",
    ],
    module_name = "TTZipPluginKitTests",
    tags = ["local"],
    visibility = ["//visibility:public"],
    deps = [
        ":TTMarkdownKit",
        ":TTZipPluginKit",
    ],
)
