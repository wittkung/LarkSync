{
    "name": "larksync",
    "displayName": "LarkSync",
    "description": "Sync Feishu Knowledge Base to local Markdown automatically",
    "version": "0.0.1",
    "publisher": "kevintung",
    "repository": {
        "type": "git",
        "url": "https://github.com/kevintung/larksync"
    },
    "engines": {
        "vscode": "^1.80.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [],
    "main": "./out/extension.js",
    "extensionKind": [
        "workspace",
        "ui"
    ],
    "contributes": {
        "commands": [
            {
                "command": "larksync.startSync",
                "title": "LarkSync: Incremental Sync (Fast)",
                "icon": "$(sync)"
            },
            {
                "command": "larksync.forceSyncTree",
                "title": "LarkSync: Force Fetch Directory Tree",
                "icon": "$(cloud-download)"
            },
            {
                "command": "larksync.refreshSidebar",
                "title": "Refresh Local Workspace",
                "icon": "$(refresh)"
            },
            {
                "command": "larksync.login",
                "title": "LarkSync: Login with Feishu Account",
                "icon": "$(log-in)"
            },
            {
                "command": "larksync.logout",
                "title": "LarkSync: Logout",
                "icon": "$(log-out)"
            }
        ],
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "larksync-container",
                    "title": "LarkSync",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "views": {
            "larksync-container": [
                {
                    "id": "larksyncSidebar",
                    "name": "Local Knowledge Base",
                    "icon": "resources/icon.svg"
                }
            ]
        },
        "menus": {
            "view/title": [
                {
                    "command": "larksync.startSync",
                    "when": "view == larksyncSidebar",
                    "group": "navigation"
                },
                {
                    "command": "larksync.forceSyncTree",
                    "when": "view == larksyncSidebar",
                    "group": "navigation"
                },
                {
                    "command": "larksync.refreshSidebar",
                    "when": "view == larksyncSidebar",
                    "group": "navigation"
                }
            ]
        },
        "configuration": {
            "title": "LarkSync",
            "properties": {
                "larksync.appId": {
                    "type": "string",
                    "default": "",
                    "description": "Feishu App ID"
                },
                "larksync.appSecret": {
                    "type": "string",
                    "default": "",
                    "description": "Feishu App Secret"
                },
                "larksync.spaceId": {
                    "type": "string",
                    "default": "",
                    "description": "Feishu Knowledge Space ID or Root Folder Token to sync"
                },
                "larksync.syncDirectory": {
                    "type": "string",
                    "default": "LarkDocs",
                    "description": "Local workspace directory name to store the synced markdown files"
                },
                "larksync.pollingIntervalMinutes": {
                    "type": "number",
                    "default": 5,
                    "description": "Interval in minutes to poll for cloud updates (0 to disable)"
                },
                "larksync.tableRenderMode": {
                    "type": "string",
                    "default": "html",
                    "enum": [
                        "html",
                        "gfm"
                    ],
                    "enumDescriptions": [
                        "HTML high-fidelity mode: supports merged cells, styling (default)",
                        "GFM pure mode: pure Markdown tables, better for GitHub/Hugo compatibility"
                    ],
                    "description": "Table rendering strategy for converted Markdown files"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
        "compile": "tsc -p ./",
        "build": "npm run clean && npm run compile && vsce package --no-dependencies",
        "watch": "tsc -watch -p ./",
        "pretest": "npm run compile"
    },
    "devDependencies": {
        "@types/node": "18.x",
        "@types/vscode": "^1.80.0",
        "@typescript-eslint/eslint-plugin": "^8.56.1",
        "@typescript-eslint/parser": "^8.56.1",
        "eslint": "^9.39.3",
        "typescript": "^5.1.3"
    },
    "dependencies": {
        "axios": "^1.6.0",
        "p-limit": "^3.1.0"
    }
}